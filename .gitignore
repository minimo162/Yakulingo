# 実行時に生成される利用者設定（配布対象は settings.template.json のみ）
app/config/user_settings.json
*/app/config/user_settings.json

# New-YakuPackage.ps1 が生成する配布物マニフェスト（派生物・タイムスタンプを含む）
manifest.json

# ローカル作業物
*.log
*.tmp
~$*
# 実資料は追跡しない。検証用に置くだけで、リポジトリへ入れない。
_docs/*.pdf
_docs/*.xlsx
_docs/*.docx
_docs/*.pptx
output/
outputs/
tmp/
# デスクトップ shell のビルド成果物。csc が毎回異なる build stamp を埋めるので、
# 追跡するとビルドのたびに差分が出て pull やブランチ切り替えが止まる。
# 無ければ tools/Test-YakuV9165DesktopShell.ps1 が作る。

